{
  "id": "fix_compile_error",
  "category": "coding_tasks",
  "goal_type": "modify_code",
  "prompt": "The crate does not compile. Find the type error, fix it, and verify with cargo check.",
  "setup": {
    "fixture": "broken_crate"
  },
  "limits": {
    "max_steps": 12,
    "max_model_calls": 10
  },
  "script": [
    {
      "kind": "task_proposal",
      "goal": {
        "type": "modify_code",
        "target": "src/lib.rs",
        "description": "Fix the type error"
      },
      "candidate_actions": [
        {
          "tool": "read_file",
          "arguments": {
            "path": "src/lib.rs"
          },
          "confidence": 0.9
        }
      ],
      "confidence": 0.9
    },
    {
      "kind": "task_proposal",
      "goal": {
        "type": "modify_code",
        "target": "src/lib.rs",
        "description": "Return an integer"
      },
      "candidate_actions": [
        {
          "tool": "apply_patch",
          "arguments": {
            "path": "src/lib.rs",
            "old_text": "\"broken\"",
            "new_text": "42"
          },
          "confidence": 0.95
        }
      ],
      "confidence": 0.9
    },
    {
      "kind": "task_proposal",
      "goal": {
        "type": "modify_code",
        "target": "src/lib.rs",
        "description": "Verify the fix"
      },
      "candidate_actions": [
        {
          "tool": "cargo_check",
          "arguments": {},
          "confidence": 0.9
        }
      ],
      "confidence": 0.9
    },
    {
      "kind": "final_answer",
      "text": "Fixed the type error and `cargo check` passed.",
      "success": true
    }
  ],
  "expect": {
    "files_modified": [
      "src/lib.rs"
    ],
    "tools_used": [
      "read_file",
      "apply_patch",
      "cargo_check"
    ],
    "approval_required": true,
    "run_status": "completed",
    "replay_hash_equal": true
  }
}
