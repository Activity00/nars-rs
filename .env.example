# nars-agent provider configuration
# openai | anthropic | ollama | demo | echo (default: demo)
NARS_AGENT_PROVIDER=demo
NARS_AGENT_MODEL=gpt-4.1-mini
NARS_AGENT_BASE_URL=https://api.openai.com/v1
NARS_AGENT_API_KEY=
# Set to 1 to request a strict JSON Schema response format (OpenAI)
NARS_AGENT_JSON_SCHEMA=0
# Optional bearer token for the HTTP API
NARS_AGENT_TOKEN=
